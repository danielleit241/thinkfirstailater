# Required in production. Use the public origin without a trailing slash.
NEXT_PUBLIC_APP_URL=https://example.com

# Add when the frontend consumes a public backend API.
NEXT_PUBLIC_API_URL=http://localhost:8080/

# PostgreSQL local dev via Docker Compose (see root docker-compose.yml).
#
# DATABASE_URL: connection app dùng lúc runtime (request-time), qua
# `@prisma/adapter-pg` trong `src/server/db.ts`. Trên Neon/Supabase thật, đây
# LÀ pooled connection string (đi qua pgbouncer/connection pooler — port/host
# thường khác direct, ví dụ Neon có host riêng cho pooled endpoint, Supabase
# dùng port 6543 cho pgbouncer). Dùng cho app vì serverless (Vercel) mở nhiều
# connection ngắn hạn, cần pooler để tránh vượt giới hạn connection của DB.
#
# DIRECT_URL: connection CLI dùng cho migration (`prisma migrate deploy`,
# xem `prisma.config.ts`). Trên Neon/Supabase thật, đây LÀ direct connection
# (bỏ qua pooler — Neon có endpoint riêng không qua pooler, Supabase dùng
# port 5432 trực tiếp), vì migration cần DDL/session-level lock mà pooler
# transaction-mode không hỗ trợ tốt.
#
# Docker Compose ở đây chỉ chạy một Postgres instance duy nhất, không có
# pooler riêng, nên 2 biến dưới đây trỏ cùng một connection string cho local
# dev — điều này CHỈ đúng ở local, không áp dụng khi deploy Vercel + Neon/Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app_dev?schema=public

# Better Auth server secret (generate a random 32+ char string for real environments).
BETTER_AUTH_SECRET=dev-only-change-me-32-characters-minimum
BETTER_AUTH_URL=http://localhost:5173

# Admin bootstrap credentials (one-time use by `npm run admin:bootstrap`).
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-dev-only
